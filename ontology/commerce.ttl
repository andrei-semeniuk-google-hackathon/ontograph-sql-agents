@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sem:  <https://ontoagents.dev/semantic#> .
@prefix c:    <https://ontoagents.dev/commerce#> .

# ---------------------------------------------------------------------------
# Semantic-layer vocabulary: how business concepts map onto the warehouse.
# ---------------------------------------------------------------------------

sem:Concept   a owl:Class ; rdfs:subClassOf skos:Concept .
sem:Entity    a owl:Class ; rdfs:subClassOf sem:Concept ; rdfs:comment "A business object backed by a table." .
sem:Metric    a owl:Class ; rdfs:subClassOf sem:Concept ; rdfs:comment "An aggregate with one governed definition." .
sem:Dimension a owl:Class ; rdfs:subClassOf sem:Concept ; rdfs:comment "Something a metric can be grouped by." .
sem:Filter    a owl:Class ; rdfs:subClassOf sem:Concept ; rdfs:comment "A named, governed predicate." .
sem:Join      a owl:Class ; rdfs:comment "An allowed join between two tables." .

sem:table          a owl:DatatypeProperty ; rdfs:comment "Table that holds the concept (the grain, for metrics)." .
sem:sqlExpression  a owl:DatatypeProperty .
sem:timeColumn     a owl:DatatypeProperty ; rdfs:comment "Column a time range applies to." .
sem:snapshot       a owl:DatatypeProperty ; rdfs:comment "True when the metric is a point-in-time state and ignores time ranges." .
sem:requiresFilter a owl:ObjectProperty ; rdfs:comment "Filter that is part of the metric definition." .
sem:allowedValue   a owl:DatatypeProperty ; rdfs:comment "A value a dimension may be filtered to. Anything else is refused." .
sem:fineGrainVariant a owl:ObjectProperty ;
    rdfs:comment "Equivalent metric to use when grouping by a dimension below this metric's grain (avoids join fan-out)." .
sem:fromTable a owl:DatatypeProperty .
sem:toTable   a owl:DatatypeProperty .
sem:on        a owl:DatatypeProperty .
sem:cardinality a owl:DatatypeProperty ;
    rdfs:comment "many-to-one (default) or one-to-one, read from fromTable to toTable. Walking a many-to-one join backwards multiplies rows." .

# ---------------------------------------------------------------------------
# Entities
# ---------------------------------------------------------------------------

c:Customer a sem:Entity ; skos:prefLabel "customer"@en ; skos:altLabel "client"@en, "buyer"@en, "member"@en ;
    skos:definition "A person or business with an account."@en ; sem:table "customers" .
c:Subscription a sem:Entity ; skos:prefLabel "subscription"@en ; skos:altLabel "membership"@en ;
    skos:definition "A recurring monthly plan held by a customer."@en ; sem:table "subscriptions" .
c:Order a sem:Entity ; skos:prefLabel "order"@en ; skos:altLabel "purchase"@en, "transaction"@en ;
    skos:definition "A checkout, one-off or generated by a subscription."@en ; sem:table "orders" .
c:OrderItem a sem:Entity ; skos:prefLabel "order line"@en ; skos:altLabel "order item"@en, "line item"@en ;
    sem:table "order_items" .
c:Product a sem:Entity ; skos:prefLabel "product"@en ; skos:altLabel "item"@en, "sku"@en, "scent"@en ;
    sem:table "products" .

# ---------------------------------------------------------------------------
# Filters
# ---------------------------------------------------------------------------

c:ActiveSubscription a sem:Filter ; skos:prefLabel "active subscription"@en ; skos:altLabel "active"@en, "live subscription"@en ;
    sem:table "subscriptions" ; sem:sqlExpression "subscriptions.status = 'active'" .
c:CancelledSubscription a sem:Filter ; skos:prefLabel "cancelled subscription"@en ; skos:altLabel "churned"@en, "cancelled"@en, "canceled"@en ;
    sem:table "subscriptions" ; sem:sqlExpression "subscriptions.status = 'cancelled'" .
c:PausedSubscription a sem:Filter ; skos:prefLabel "paused subscription"@en ; skos:altLabel "paused"@en, "on hold"@en ;
    sem:table "subscriptions" ; sem:sqlExpression "subscriptions.status = 'paused'" .
c:PaidOrder a sem:Filter ; skos:prefLabel "paid order"@en ; skos:altLabel "paid"@en, "completed order"@en ;
    sem:table "orders" ; sem:sqlExpression "orders.status = 'paid'" .
c:RefundedOrder a sem:Filter ; skos:prefLabel "refunded order"@en ; skos:altLabel "refunded"@en, "returned"@en ;
    sem:table "orders" ; sem:sqlExpression "orders.status = 'refunded'" .
c:BusinessCustomer a sem:Filter ; skos:prefLabel "business customer"@en ; skos:altLabel "b2b"@en, "corporate"@en, "business"@en ;
    sem:table "customers" ; sem:sqlExpression "customers.segment = 'business'" .
c:ConsumerCustomer a sem:Filter ; skos:prefLabel "consumer customer"@en ; skos:altLabel "b2c"@en, "consumer"@en, "retail customer"@en ;
    sem:table "customers" ; sem:sqlExpression "customers.segment = 'consumer'" .

# ---------------------------------------------------------------------------
# Metrics
# ---------------------------------------------------------------------------

c:MRR a sem:Metric ; skos:prefLabel "monthly recurring revenue"@en ; skos:altLabel "mrr"@en, "recurring revenue"@en ;
    skos:definition "Sum of the monthly price of subscriptions that are active right now."@en ;
    sem:table "subscriptions" ; sem:sqlExpression "SUM(subscriptions.monthly_price)" ;
    sem:requiresFilter c:ActiveSubscription ; sem:snapshot true .

c:ActiveSubscribers a sem:Metric ; skos:prefLabel "active subscribers"@en ;
    skos:altLabel "subscribers"@en, "active subscriptions"@en, "subscriber count"@en ;
    skos:definition "Distinct customers holding an active subscription right now."@en ;
    sem:table "subscriptions" ; sem:sqlExpression "COUNT(DISTINCT subscriptions.customer_id)" ;
    sem:requiresFilter c:ActiveSubscription ; sem:snapshot true .

c:Cancellations a sem:Metric ; skos:prefLabel "cancellations"@en ;
    skos:altLabel "churn"@en, "churned subscriptions"@en, "cancelled subscriptions"@en ;
    skos:definition "Number of subscriptions that were cancelled; time ranges apply to the cancellation date."@en ;
    sem:table "subscriptions" ; sem:sqlExpression "COUNT(subscriptions.id)" ;
    sem:requiresFilter c:CancelledSubscription ; sem:timeColumn "subscriptions.cancelled_at" .

c:NetRevenue a sem:Metric ; skos:prefLabel "net revenue"@en ;
    skos:altLabel "revenue"@en, "sales"@en, "turnover"@en, "income"@en ;
    skos:definition "Value of paid orders. Refunded and pending orders are excluded."@en ;
    sem:table "orders" ; sem:sqlExpression "SUM(orders.total_amount)" ;
    sem:requiresFilter c:PaidOrder ; sem:timeColumn "orders.created_at" ;
    sem:fineGrainVariant c:ItemRevenue .

c:ItemRevenue a sem:Metric ; skos:prefLabel "item revenue"@en ; skos:altLabel "product revenue"@en, "line revenue"@en ;
    skos:definition "Net revenue computed from order lines; the correct form when grouping by product attributes."@en ;
    sem:table "order_items" ; sem:sqlExpression "SUM(order_items.quantity * order_items.unit_price)" ;
    sem:requiresFilter c:PaidOrder ; sem:timeColumn "orders.created_at" .

c:OrderCount a sem:Metric ; skos:prefLabel "number of orders"@en ;
    skos:altLabel "orders"@en, "order count"@en, "order volume"@en ;
    sem:table "orders" ; sem:sqlExpression "COUNT(DISTINCT orders.id)" ;
    sem:requiresFilter c:PaidOrder ; sem:timeColumn "orders.created_at" .

c:AverageOrderValue a sem:Metric ; skos:prefLabel "average order value"@en ;
    skos:altLabel "aov"@en, "average basket"@en, "average order"@en ;
    sem:table "orders" ; sem:sqlExpression "ROUND(AVG(orders.total_amount), 2)" ;
    sem:requiresFilter c:PaidOrder ; sem:timeColumn "orders.created_at" .

c:UnitsSold a sem:Metric ; skos:prefLabel "units sold"@en ; skos:altLabel "units"@en, "items sold"@en, "quantity sold"@en ;
    sem:table "order_items" ; sem:sqlExpression "SUM(order_items.quantity)" ;
    sem:requiresFilter c:PaidOrder ; sem:timeColumn "orders.created_at" .

c:RefundedAmount a sem:Metric ; skos:prefLabel "refunded amount"@en ; skos:altLabel "refunds"@en, "refund value"@en ;
    sem:table "orders" ; sem:sqlExpression "SUM(orders.total_amount)" ;
    sem:requiresFilter c:RefundedOrder ; sem:timeColumn "orders.created_at" .

# ---------------------------------------------------------------------------
# Dimensions
# ---------------------------------------------------------------------------

c:Country a sem:Dimension ; skos:prefLabel "country"@en ; skos:altLabel "market"@en, "geo"@en, "nation"@en ;
    sem:table "customers" ; sem:sqlExpression "customers.country" ;
    sem:allowedValue "US", "GB", "DE", "FR", "CY", "CA" .
c:Segment a sem:Dimension ; skos:prefLabel "customer segment"@en ; skos:altLabel "segment"@en, "customer type"@en ;
    sem:table "customers" ; sem:sqlExpression "customers.segment" ;
    sem:allowedValue "consumer", "business" .
c:Plan a sem:Dimension ; skos:prefLabel "plan"@en ; skos:altLabel "subscription plan"@en, "tier"@en, "plan type"@en ;
    sem:table "subscriptions" ; sem:sqlExpression "subscriptions.plan" ;
    sem:allowedValue "basic", "premium", "family" .
c:Brand a sem:Dimension ; skos:prefLabel "brand"@en ; skos:altLabel "label"@en, "house"@en, "maker"@en ;
    sem:table "products" ; sem:sqlExpression "products.brand" ;
    sem:allowedValue "Maison Nord", "Atelier Sud", "Kyoto Lab", "Verde", "Lumen" .
c:Category a sem:Dimension ; skos:prefLabel "product category"@en ; skos:altLabel "category"@en, "product type"@en ;
    sem:table "products" ; sem:sqlExpression "products.category" ;
    sem:allowedValue "fragrance", "candle", "body care", "gift set" .
c:OrderMonth a sem:Dimension ; skos:prefLabel "order month"@en ; skos:altLabel "month"@en, "monthly"@en, "per month"@en ;
    sem:table "orders" ; sem:sqlExpression "date_trunc('month', orders.created_at)" .
c:CohortMonth a sem:Dimension ; skos:prefLabel "signup cohort"@en ; skos:altLabel "cohort"@en, "start month"@en ;
    sem:table "subscriptions" ; sem:sqlExpression "date_trunc('month', subscriptions.started_at)" .

# ---------------------------------------------------------------------------
# Allowed joins. Anything not listed here is not a join the agents may invent.
# ---------------------------------------------------------------------------

c:OrdersToCustomers a sem:Join ; sem:fromTable "orders" ; sem:toTable "customers" ;
    sem:on "orders.customer_id = customers.id" .
c:SubscriptionsToCustomers a sem:Join ; sem:fromTable "subscriptions" ; sem:toTable "customers" ;
    sem:on "subscriptions.customer_id = customers.id" ; sem:cardinality "one-to-one" .
c:ItemsToOrders a sem:Join ; sem:fromTable "order_items" ; sem:toTable "orders" ;
    sem:on "order_items.order_id = orders.id" .
c:ItemsToProducts a sem:Join ; sem:fromTable "order_items" ; sem:toTable "products" ;
    sem:on "order_items.product_id = products.id" .
